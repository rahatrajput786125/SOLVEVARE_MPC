# Copy to .env and fill in values. Never commit .env to git.

# PostgreSQL — use PgBouncer URL in production (port 6432, not 5432)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mpc_dev?schema=public"

# Read replica for analytics queries (optional in dev)
DATABASE_READ_URL="postgresql://postgres:password@localhost:5432/mpc_dev?schema=public"
