// =============================================================================
// MPC SaaS — Production Database Schema
// Engine: PostgreSQL via Prisma ORM
//
// Design decisions:
// - UUID PKs: prevents enumeration, works across future shards
// - org_id on every tenant table: logical multi-tenancy
// - soft deletes (deletedAt): audit trail, recovery, billing disputes
// - jsonb (Json type): flexible metadata without constant migrations
// - explicit indexes on every foreign key + every filterable column
// - enums for all finite state machines: DB enforces valid transitions
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS — finite state machines enforced at DB level
// =============================================================================

enum UserRole {
  SUPER_ADMIN  // platform-level admin (us)
  ORG_OWNER    // owns the organization, full access
  ORG_ADMIN    // can manage members, projects, billing
  ORG_MEMBER   // can create/edit projects and templates
  ORG_VIEWER   // read-only access
}

enum OrgPlan {
  FREE
  STARTER
  GROWTH
  BUSINESS
  ENTERPRISE
}

enum OrgStatus {
  ACTIVE
  SUSPENDED   // payment failed or policy violation
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum DataSourceType {
  CSV
  EXCEL
  GOOGLE_SHEETS
  AIRTABLE
  JSON
  API_ENDPOINT
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PageStatus {
  DRAFT
  GENERATING   // currently being processed by worker
  GENERATED    // content ready, not yet published
  PUBLISHING   // being pushed to destination
  PUBLISHED
  FAILED
  ARCHIVED
}

enum PublishTarget {
  WORDPRESS
  STATIC_HTML
  NEXTJS
  WEBHOOK
  HEADLESS_CMS
}

enum PublishJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GEMINI
}

enum AIStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CACHED    // served from cache, no API call made
}

enum SchemaMarkupType {
  LOCAL_BUSINESS
  ARTICLE
  FAQ
  BREADCRUMB
  PRODUCT
  SERVICE
  REVIEW
  HOW_TO
  ORGANIZATION
  WEBSITE
}

enum LinkType {
  TOPIC_CLUSTER    // same service, different locations
  LOCATION_CLUSTER // same location, different services
  SEMANTIC         // embedding similarity
  MANUAL           // user-defined
  HUB_SPOKE        // pillar page → supporting page
}

enum WebhookEvent {
  PAGE_GENERATED
  PAGE_PUBLISHED
  IMPORT_COMPLETED
  IMPORT_FAILED
  PUBLISH_JOB_COMPLETED
  PUBLISH_JOB_FAILED
  USAGE_LIMIT_REACHED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  IMPORT
  EXPORT
  LOGIN
  LOGOUT
  INVITE
  REVOKE
}

// =============================================================================
// 1. USERS
// A user can belong to multiple organizations (via OrgMember).
// Auth is handled by JWT; OAuth providers stored in accounts table.
// =============================================================================

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?   // null if OAuth-only user
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // soft delete

  // relations
  memberships   OrgMember[]
  accounts      OAuthAccount[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]

  @@index([deletedAt])
  @@map("users")
}

// OAuth provider accounts linked to a user (Google, GitHub, etc.)
model OAuthAccount {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId            String @db.ObjectId
  provider          String   // "google" | "github"
  providerAccountId String   // the ID from the OAuth provider
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// =============================================================================
// 2. ORGANIZATIONS (Tenants)
// The top-level tenant boundary. Every piece of data belongs to an org.
// =============================================================================

model Organization {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String    @unique  // used in URLs: app.mpc.io/org/acme
  logoUrl   String?
  plan      OrgPlan   @default(FREE)
  status    OrgStatus @default(ACTIVE)

  // Stripe references — never store card data, only Stripe IDs
  // Note: Not marked @unique to avoid MongoDB null uniqueness issues
  // Uniqueness is enforced at the application level when the value is set
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // usage limits enforced at application layer
  settings  Json      @default("{}")  // { maxPages, maxProjects, aiCredits, ... }

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // relations
  members       OrgMember[]
  projects      Project[]
  domains       Domain[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  billing       Billing?
  usageRecords  UsageRecord[]
  auditLogs     AuditLog[]
  invites       OrgInvite[]

  @@index([deletedAt])
  @@map("organizations")
}

// Junction table: User ↔ Organization with role
model OrgMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId     String @db.ObjectId
  userId    String @db.ObjectId
  role      UserRole  @default(ORG_MEMBER)
  joinedAt  DateTime  @default(now())
  deletedAt DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])  // one membership per user per org
  @@index([orgId])
  @@index([userId])
  @@map("org_members")
}

// Pending invitations (email not yet registered)
model OrgInvite {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId     String @db.ObjectId
  email     String
  role      UserRole  @default(ORG_MEMBER)
  token     String    @unique  // secure random token sent in email
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
  @@map("org_invites")
}

// =============================================================================
// 3. PROJECTS
// A project groups templates + data sources + generated pages.
// One org can have many projects (e.g., one per client site).
// =============================================================================

model Project {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String @db.ObjectId
  name        String
  description String?
  slug        String        // unique within org, not globally
  status      ProjectStatus @default(ACTIVE)
  settings    Json          @default("{}")  // default SEO settings, AI config, etc.
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templates    Template[]
  dataSources  DataSource[]
  pages        GeneratedPage[]
  publishJobs  PublishJob[]
  sitemaps     Sitemap[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([orgId, status])
  @@index([deletedAt])
  @@map("projects")
}

// =============================================================================
// 4. TEMPLATES
// The HTML/Markdown template with variable placeholders.
// Versioned so users can roll back to previous versions.
// =============================================================================

model Template {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String @db.ObjectId
  projectId   String @db.ObjectId
  name        String
  description String?

  // The raw template content with {{variable}} placeholders
  // Stored as text, not jsonb — it's a document, not structured data
  content     String   

  // Original <head> inner content from imported HTML (CSS/JS links preserved)
  headContent String?  // null for manually created templates

  // SEO template fields — also use placeholders
  titleTemplate       String   // e.g. "Best {{service}} in {{city}} | {{brand}}"
  descriptionTemplate String   // e.g. "Find top {{service}} providers in {{city}}."
  slugTemplate        String   // e.g. "{{service}}-in-{{city}}"

  // Schema markup template (JSON-LD template with placeholders)
  schemaTemplate Json?

  // Which variables this template expects — validated at generation time
  variables   TemplateVariable[]

  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages        GeneratedPage[]
  versions     TemplateVersion[]

  @@index([orgId])
  @@index([projectId])
  @@index([deletedAt])
  @@map("templates")
}

// Immutable snapshot of a template at each save — enables rollback
model TemplateVersion {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  templateId  String @db.ObjectId
  version     Int
  content     String   
  titleTemplate       String
  descriptionTemplate String
  slugTemplate        String
  schemaTemplate      Json?
  createdAt   DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

// =============================================================================
// 5. TEMPLATE VARIABLES
// Declares what variables a template expects, their types, and defaults.
// Used for validation before generation starts.
// =============================================================================

model TemplateVariable {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  templateId   String @db.ObjectId
  name         String   // e.g. "city", "service", "phone"
  type         String   @default("text")  // text | number | url | image | ai
  required     Boolean  @default(true)
  defaultValue String?
  description  String?  // shown in UI to help user map CSV columns

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, name])
  @@index([templateId])
  @@map("template_variables")
}

// =============================================================================
// 6. DATA SOURCES
// Represents a connected data source (CSV file, Google Sheet, etc.)
// One data source can be used across multiple generation runs.
// =============================================================================

model DataSource {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String @db.ObjectId
  projectId   String @db.ObjectId
  name        String
  type        DataSourceType
  // For file uploads: S3/R2 key. For sheets: spreadsheet URL.
  sourceUrl   String?
  // Column mapping: { "City": "city", "Service Name": "service" }
  columnMap   Json           @default("{}")
  rowCount    Int?           // populated after import completes
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imports CsvImport[]

  @@index([orgId])
  @@index([projectId])
  @@index([deletedAt])
  @@map("data_sources")
}

// =============================================================================
// 7. CSV IMPORTS
// Each import run against a data source. Tracks progress for large files.
// Chunked processing: one BullMQ job per chunk of 1000 rows.
// =============================================================================

model CsvImport {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId          String @db.ObjectId
  dataSourceId   String @db.ObjectId
  status         ImportStatus @default(PENDING)
  totalRows      Int          @default(0)
  processedRows  Int          @default(0)
  failedRows     Int          @default(0)
  // S3 key of the uploaded raw file
  fileKey        String?
  // Errors collected during processing (max 100 stored)
  errors         Json         @default("[]")
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([dataSourceId])
  @@index([status])
  @@map("csv_imports")
}

// =============================================================================
// 8. GENERATED PAGES
// The core output entity. One row per generated page.
// This table will be the largest — designed for partitioning.
//
// Partitioning strategy: RANGE partition by created_at (monthly)
// or HASH partition by org_id for even distribution.
// Prisma doesn't manage partitions — handled via raw SQL migrations.
// =============================================================================

model GeneratedPage {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String @db.ObjectId
  projectId   String @db.ObjectId
  templateId  String @db.ObjectId

  // Metadata only — HTML stored on disk at filePath
  slug        String
  title       String
  filePath    String   // absolute path: dist/<projectId>/<templateId>/<slug>.html

  // SEO
  canonicalUrl  String?
  focusKeyword  String?
  seoScore      Int?

  status      PageStatus @default(DRAFT)

  // AI content attached to this page
  aiGenerations AiGeneration[]

  // Publishing
  publishedUrl  String?
  publishedAt   DateTime?

  // Internal linking
  outboundLinks InternalLink[] @relation("SourcePage")
  inboundLinks  InternalLink[] @relation("TargetPage")

  // Schema markup
  schemaMarkups SchemaMarkup[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  @@unique([projectId, templateId, slug])
  @@index([orgId])
  @@index([projectId])
  @@index([projectId, status])
  @@index([templateId])
  @@index([status])
  @@index([deletedAt])
  @@map("generated_pages")
}

// =============================================================================
// 9. AI GENERATIONS
// Tracks every AI API call: provider, prompt, response, tokens, cost.
// Enables cost tracking, caching, and quality scoring.
// =============================================================================

model AiGeneration {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String @db.ObjectId
  pageId      String @db.ObjectId
  provider    AIProvider @default(OPENAI)
  model       String     // "gpt-4o", "claude-3-5-sonnet", etc.

  // The placeholder this generation fills: "faq", "intro", "title"
  placeholder String

  // Prompt sent to AI (stored for debugging and re-generation)
  prompt      String     
  // Raw response from AI
  response    String     

  // Token tracking for cost calculation
  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  totalTokens      Int   @default(0)
  costUsd          Float @default(0)

  // Cache key: hash of (provider + model + prompt) — checked before API call
  cacheKey    String?   @unique

  status      AIStatus  @default(PENDING)
  qualityScore Int?     // 0-100: length, uniqueness, keyword presence

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  page GeneratedPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([pageId])
  @@index([orgId, createdAt])  // for usage/cost reports
  @@map("ai_generations")
}

// =============================================================================
// 10. SCHEMA MARKUPS
// JSON-LD structured data attached to a page.
// Separated from the page so multiple schema types can exist per page.
// =============================================================================

model SchemaMarkup {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId     String @db.ObjectId
  pageId    String @db.ObjectId
  type      SchemaMarkupType
  // The rendered JSON-LD object (not a string — stored as jsonb for querying)
  data      Json
  isValid   Boolean          @default(false)  // validated against schema.org spec
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  page GeneratedPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([pageId])
  @@map("schema_markups")
}

// =============================================================================
// 11. INTERNAL LINKS
// Directed graph of links between generated pages.
// source → target with anchor text and link type.
// =============================================================================

model InternalLink {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String @db.ObjectId
  projectId    String @db.ObjectId
  sourcePageId String @db.ObjectId
  targetPageId String @db.ObjectId
  anchorText   String
  linkType     LinkType @default(TOPIC_CLUSTER)
  createdAt    DateTime @default(now())

  sourcePage GeneratedPage @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage GeneratedPage @relation("TargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)

  // Prevent duplicate links between same pair
  @@unique([sourcePageId, targetPageId])
  @@index([orgId])
  @@index([projectId])
  @@index([sourcePageId])
  @@index([targetPageId])
  @@map("internal_links")
}

// =============================================================================
// 12. PUBLISH JOBS
// A batch publish operation. One job = one publish run for a project.
// Tracks progress across potentially thousands of pages.
// =============================================================================

model PublishJob {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String @db.ObjectId
  projectId     String @db.ObjectId
  target        PublishTarget
  status        PublishJobStatus @default(QUEUED)

  // Target-specific config: WP credentials, S3 bucket, webhook URL, etc.
  // Encrypted at application layer before storage
  config        Json             @default("{}")

  totalPages     Int @default(0)
  publishedPages Int @default(0)
  failedPages    Int @default(0)

  errors        Json     @default("[]")
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId])
  @@index([status])
  @@map("publish_jobs")
}

// =============================================================================
// 13. DOMAINS
// Custom domains attached to an org for publishing.
// =============================================================================

model Domain {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String @db.ObjectId
  domain      String   @unique  // e.g. "pages.acme.com"
  isVerified  Boolean  @default(false)
  verifyToken String?  // DNS TXT record value for verification
  sslStatus   String   @default("pending")  // pending | active | failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("domains")
}

// =============================================================================
// 14. API KEYS
// Scoped API keys for programmatic access and webhook verification.
// Only the hash is stored — the raw key is shown once at creation.
// =============================================================================

model ApiKey {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String @db.ObjectId
  userId      String @db.ObjectId
  name        String    // human label: "Production Key", "CI Key"
  keyHash     String    @unique  // SHA-256 hash of the raw key
  keyPrefix   String    // first 8 chars shown in UI: "mpc_live_abc12345..."
  scopes      String[]  // ["pages:read", "pages:write", "publish"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@map("api_keys")
}

// =============================================================================
// 15. BILLING
// One billing record per org. Stripe is the source of truth for payment state.
// We mirror only what we need for feature gating and usage limits.
// =============================================================================

model Billing {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId                String          @unique @db.ObjectId
  stripeCustomerId     String          @unique
  stripeSubscriptionId String?         @unique
  stripePriceId        String?
  plan                 OrgPlan         @default(FREE)
  interval             BillingInterval @default(MONTHLY)
  status               String          @default("active")  // mirrors Stripe status
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean         @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("billing")
}

// =============================================================================
// 16. USAGE RECORDS
// Metered usage tracking per org per period.
// Checked before every generation/AI call to enforce plan limits.
// Aggregated daily — not per-event — to keep table size manageable.
// =============================================================================

model UsageRecord {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String @db.ObjectId
  // The metric being tracked
  metric      String   // "pages_generated" | "ai_tokens" | "ai_calls" | "exports"
  value       Int      @default(0)
  // Aggregated per day — one row per org per metric per day
  date        DateTime 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, metric, date])
  @@index([orgId, metric])
  @@index([orgId, date])
  @@map("usage_records")
}

// =============================================================================
// 17. WEBHOOKS
// Outbound webhooks fired on platform events.
// Delivery attempts tracked for retry logic.
// =============================================================================

model Webhook {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId     String @db.ObjectId
  url       String
  events    WebhookEvent[]
  secret    String         // HMAC-SHA256 signing secret (stored encrypted)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([orgId])
  @@map("webhooks")
}

// Each delivery attempt for a webhook event
model WebhookDelivery {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  webhookId    String @db.ObjectId
  event        WebhookEvent
  payload      Json
  responseCode Int?
  responseBody String?  
  success      Boolean  @default(false)
  attempt      Int      @default(1)  // retry counter
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, success])
  @@map("webhook_deliveries")
}

// =============================================================================
// 18. SITEMAPS
// Generated sitemap files stored in S3. One per project.
// Regenerated after each publish batch.
// =============================================================================

model Sitemap {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String @db.ObjectId
  projectId   String @db.ObjectId
  // S3/R2 key where the sitemap XML is stored
  fileKey     String
  publicUrl   String
  pageCount   Int      @default(0)
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId])
  @@index([orgId])
  @@map("sitemaps")
}

// =============================================================================
// 19. GENERATION RUNS
// Tracks every page generation request end-to-end.
// One record per POST /generate call — updated as chunks complete.
// =============================================================================

enum GenerationRunStatus {
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL    // some chunks succeeded, some failed — pages partially generated
  FAILED
  CANCELLED
}

model GenerationRun {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String              @db.ObjectId
  projectId    String              @db.ObjectId
  templateId   String              @db.ObjectId
  dataSourceId String              @db.ObjectId
  status       GenerationRunStatus @default(QUEUED)
  totalRows    Int                 @default(0)
  processedRows Int                @default(0)
  generatedPages Int               @default(0)
  failedPages  Int                 @default(0)
  totalChunks  Int                 @default(0)
  doneChunks   Int                 @default(0)
  failedChunks Int                 @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([orgId])
  @@index([projectId])
  @@index([orgId, status])
  @@index([createdAt])
  @@map("generation_runs")
}

// =============================================================================
// 20. EXPORT JOBS
// Tracks a ZIP export request. The worker streams pages from disk into a ZIP
// and stores it at a temporary path. The API polls status + serves download.
// =============================================================================

enum ExportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model ExportJob {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String          @db.ObjectId
  projectId   String          @db.ObjectId
  templateId  String?         @db.ObjectId  // null = all templates
  status      ExportJobStatus @default(QUEUED)
  totalPages  Int             @default(0)
  zipPath      String?         // absolute path of the produced ZIP file
  reportPath   String?         // absolute path of export-report.json
  validationPassed Boolean?    // true if all checks passed
  errorMessage String?
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?       // ZIP is deleted after this time
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orgId])
  @@index([projectId])
  @@index([orgId, status])
  @@map("export_jobs")
}

// =============================================================================
// 21. AUDIT LOGS
// Immutable log of every significant action in the system.
// Never updated, never soft-deleted — append-only.
// Partitioned by created_at in production (monthly partitions).
// =============================================================================

model AuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orgId      String @db.ObjectId
  userId     String? @db.ObjectId  // null for system actions
  action     AuditAction
  resource   String      // "template" | "page" | "project" | etc.
  resourceId String? @db.ObjectId
  // Before/after snapshot for UPDATE actions
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([orgId, action])
  @@index([orgId, resource, resourceId])
  @@index([userId])
  @@index([createdAt])  // for time-range queries
  @@map("audit_logs")
}
