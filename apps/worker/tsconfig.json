{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@mpc/database": ["../../packages/database/src"],
      "@mpc/shared": ["../../packages/shared/src"],
      "@mpc/queue": ["../../packages/queue/src"],
      "@mpc/template-engine": ["../../packages/template-engine/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
