{
  "name": "@mpc/worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@mpc/database": "*",
    "@mpc/queue": "*",
    "@mpc/shared": "*",
    "@mpc/template-engine": "*",
    "@nestjs/bull": "^10.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/schedule": "^4.1.0",
    "@types/archiver": "^6.0.2",
    "archiver": "^7.0.1",
    "axios": "^1.7.2",
    "bull": "^4.12.2",
    "csv-parse": "^5.5.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "^@mpc/shared$": "<rootDir>/../../packages/shared/src/index.ts",
      "^@mpc/queue$": "<rootDir>/../../packages/queue/src/index.ts"
    }
  }
}
