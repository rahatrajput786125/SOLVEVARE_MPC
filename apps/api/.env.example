# ── Database ──────────────────────────────────────────────────
DATABASE_URL="mongodb://localhost:27017mpc_dev"
#DATABASE_READ_URL="postgresql://postgres:password@localhost:5432/mpc_dev"

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-refresh-secret-too"
JWT_REFRESH_EXPIRES_IN="7d"

# ── App ───────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
API_VERSION="v1"
FRONTEND_URL="http://localhost:3000"

# ── AWS S3 / Cloudflare R2 ────────────────────────────────────
S3_BUCKET="mpc-uploads"
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID="<access_key>"
AWS_SECRET_ACCESS_KEY="<secret_key>"

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY="<openai_key>"

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY="<stripe_secret>"
STRIPE_WEBHOOK_SECRET="<stripe_webhook_secret>"

# Stripe Price IDs — create these in Stripe Dashboard → Products
STRIPE_PRICE_STARTER_MONTHLY="price_xxx"
STRIPE_PRICE_STARTER_YEARLY="price_xxx"
STRIPE_PRICE_GROWTH_MONTHLY="price_xxx"
STRIPE_PRICE_GROWTH_YEARLY="price_xxx"
STRIPE_PRICE_BUSINESS_MONTHLY="price_xxx"
STRIPE_PRICE_BUSINESS_YEARLY="price_xxx"

# ── Encryption ────────────────────────────────────────────────
ENCRYPTION_KEY="32-char-hex-key-for-aes-256-gcm"

# ── Generated pages storage (worker only) ────────────────────
# MUST be outside apps/worker/dist — nest build wipes that directory.
# Production: absolute path on a persistent volume.
# Local dev: relative path is fine.
# PAGES_DIST_ROOT=/data/generated-pages
PAGES_DIST_ROOT=./local-pages
